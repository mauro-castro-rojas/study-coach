# Python bytecode
# Python creates them to speed up loading modules:
# __pycache__/ is the folder where Python stores them.
# *.pyc is compiled bytecode for regular Python files.
# *.pyo is optimized bytecode.
# *.pyd is a compiled Python extension on Windows.
__pycache__/
*.py[cod]

# Local Python virtual environments
**/.venv/
**/venv/

# Jupyter's automatic notebook checkpoints
**/.ipynb_checkpoints/

# Local reference books (often OneDrive symlinks)
**/*.pdf

# Private Study Room records and local state
/records/study.sqlite3
/records/study.sqlite3-*
/records/progress.json
/records/references.json
/records/runtime/
/records/sessions/
/records/weekly/

# Topic materials are learner-specific; topics/README.md documents the layout.
/topics/*
!/topics/README.md
